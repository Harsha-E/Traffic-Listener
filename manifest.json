{
  "manifest_version": 3,
  "name": "NetListener — Network Traffic & API Intelligence",
  "short_name": "NetListener",
  "version": "1.0.0",
  "description": "Inspect and understand local web application backend communications, HTTP request structures, and endpoint patterns.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "NetListener Traffic Inspector"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "devtools_page": "devtools/devtools.html",
  "permissions": [
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
